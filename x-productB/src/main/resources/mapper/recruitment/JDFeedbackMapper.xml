<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="xCloud.mapper.recruitment.JDFeedbackMapper">

    <!-- 根据JD ID查询所有反馈 -->
    <select id="selectByJdId" resultType="xCloud.entity.recruitment.JDFeedback">
        SELECT * FROM jd_feedback
        WHERE jd_id = #{jdId}
        ORDER BY created_at DESC
    </select>

</mapper>
