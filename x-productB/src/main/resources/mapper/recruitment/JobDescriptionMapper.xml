<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="xCloud.mapper.recruitment.JobDescriptionMapper">

    <!-- 根据创建人查询JD列表 -->
    <select id="selectByCreatorId" resultType="xCloud.entity.recruitment.JobDescription">
        SELECT * FROM job_description
        WHERE creator_id = #{creatorId} AND deleted = 0
        ORDER BY created_at DESC
    </select>

    <!-- 根据状态查询JD列表 -->
    <select id="selectByStatus" resultType="xCloud.entity.recruitment.JobDescription">
        SELECT * FROM job_description
        WHERE status = #{status} AND deleted = 0
        ORDER BY created_at DESC
    </select>

</mapper>
